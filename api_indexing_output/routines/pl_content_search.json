{
  "name": "pl_content_search",
  "description": "Search Premier League content (articles and videos) using the public content search API with pagination and basic filters.",
  "operations": [
    {
      "type": "navigate",
      "url": "https://api.premierleague.com/content/premierleague/en?offset={{offset}}&pageSize={{pageSize}}&contentTypes={{contentTypes}}&sort={{sort}}&sortOrder={{sortOrder}}",
      "sleep_after_navigation_seconds": 2.0
    },
    {
      "type": "js_evaluate",
      "js": "(() => { try { const text = document.body && document.body.innerText ? document.body.innerText : null; if (!text) { return { ok: false, error: 'No body text found' }; } const parsed = JSON.parse(text); return parsed; } catch (e) { return { ok: false, error: String(e) }; } })();",
      "timeout_seconds": 10.0,
      "session_storage_key": "pl_content_search_result"
    },
    {
      "type": "return",
      "session_storage_key": "pl_content_search_result"
    }
  ],
  "parameters": [
    {
      "name": "offset",
      "type": "integer",
      "required": true,
      "description": "Zero-based offset into the result set for pagination.",
      "default": 0,
      "examples": [],
      "min_length": null,
      "max_length": null,
      "min_value": null,
      "max_value": null,
      "pattern": null,
      "enum_values": null,
      "format": null,
      "observed_value": null
    },
    {
      "name": "pageSize",
      "type": "integer",
      "required": true,
      "description": "Number of content items per page.",
      "default": 20,
      "examples": [],
      "min_length": null,
      "max_length": null,
      "min_value": null,
      "max_value": null,
      "pattern": null,
      "enum_values": null,
      "format": null,
      "observed_value": null
    },
    {
      "name": "contentTypes",
      "type": "string",
      "required": true,
      "description": "Comma-separated list of content types to include (e.g., VIDEO,TEXT).",
      "default": "VIDEO,TEXT",
      "examples": [],
      "min_length": null,
      "max_length": null,
      "min_value": null,
      "max_value": null,
      "pattern": null,
