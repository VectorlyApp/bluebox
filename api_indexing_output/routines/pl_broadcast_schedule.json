{
  "name": "pl_broadcast_schedule",
  "description": "Fetch Premier League broadcasting events schedule for a given date range from the public broadcasting/events API.",
  "operations": [
    {
      "type": "navigate",
      "url": "https://api.premierleague.com/broadcasting/events?from={{from}}&to={{to}}&pageSize={{pageSize}}&page={{page}}",
      "sleep_after_navigation_seconds": 2.0
    },
    {
      "type": "js_evaluate",
      "js": "(() => { try { const text = document.body && document.body.innerText ? document.body.innerText : null; if (!text) { return { ok: false, error: 'No body text found' }; } const parsed = JSON.parse(text); return parsed; } catch (e) { return { ok: false, error: String(e) }; } })();",
      "timeout_seconds": 10.0,
      "session_storage_key": "pl_broadcast_schedule_result"
    },
    {
      "type": "return",
      "session_storage_key": "pl_broadcast_schedule_result"
    }
  ],
  "parameters": [
    {
      "name": "from",
      "type": "date",
      "required": true,
      "description": "Start date (YYYY-MM-DD) for the broadcast schedule window.",
      "default": null,
      "examples": [],
      "min_length": null,
      "max_length": null,
