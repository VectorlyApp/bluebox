{
  "name": "pl_standings",
  "description": "Fetch Premier League standings table for a given competition and season from Pulselive API",
  "operations": [
    {
      "type": "navigate",
      "url": "https://www.premierleague.com/en/",
      "sleep_after_navigation_seconds": 3.0
    },
    {
      "type": "fetch",
      "endpoint": {
        "url": "https://sdp-prem-prod.premier-league-prod.pulselive.com/api/v5/competitions/{{competitionId}}/seasons/{{seasonId}}/standings",
        "description": null,
        "method": "GET",
        "headers": {
          "Accept": "application/json"
        },
        "body": null,
        "credentials": "same-origin"
      },
      "session_storage_key": "pl_standings_result"
    },
    {
      "type": "return",
      "session_storage_key": "pl_standings_result"
    }
  ],
  "parameters": [
    {
      "name": "competitionId",
      "type": "integer",
      "required": true,
      "description": "Competition ID as used by Pulselive (e.g. 8 for Premier League)",
      "default": null,
      "examples": [],
