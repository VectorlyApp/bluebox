  "routine_json": {
    "name": "pl_match_details",
    "description": "Fetch detailed match events and lineups for a given matchId from the Pulselive Premier League API via direct navigation to the events and lineups endpoints.",
    "operations": [
      {
        "type": "navigate",
        "url": "https://sdp-prem-prod.premier-league-prod.pulselive.com/api/v1/matches/{{matchId}}/events",
        "sleep_after_navigation_seconds": 3.0
      },
      {
        "type": "js_evaluate",
        "js": "(() => { try { const text = document.body && document.body.innerText ? document.body.innerText : null; if (!text) { return { ok: false, error: 'No body text for events' }; } const parsed = JSON.parse(text); return parsed; } catch (e) { return { ok: false, error: String(e) }; } })();",
        "timeout_seconds": 10.0,
        "session_storage_key": "pl_match_events_result"
      },
      {
        "type": "navigate",
        "url": "https://sdp-prem-prod.premier-league-prod.pulselive.com/api/v3/matches/{{matchId}}/lineups",
        "sleep_after_navigation_seconds": 3.0
      },
      {
        "type": "js_evaluate",
        "js": "(() => { try { const text = document.body && document.body.innerText ? document.body.innerText : null; if (!text) { return { ok: false, error: 'No body text for lineups' }; } const parsed = JSON.parse(text); return parsed; } catch (e) { return { ok: false, error: String(e) }; } })();",
        "timeout_seconds": 10.0,
        "session_storage_key": "pl_match_lineups_result"
      },
      {
        "type": "js_evaluate",
        "js": "(() => { try { const eventsRaw = sessionStorage.getItem('pl_match_events_result'); const lineupsRaw = sessionStorage.getItem('pl_match_lineups_result'); const events = eventsRaw ? JSON.parse(eventsRaw) : null; const lineups = lineupsRaw ? JSON.parse(lineupsRaw) : null; return { events, lineups }; } catch (e) { return { ok: false, error: String(e) }; } })();",
        "timeout_seconds": 5.0,
        "session_storage_key": "pl_match_details_bundle"
      },
      {
        "type": "return",
        "session_storage_key": "pl_match_details_bundle"
      }
    ],
    "parameters": [
      {
        "name": "matchId",
        "type": "integer",
        "required": true,
        "description": "Pulselive match identifier (e.g., 2562154).",
        "default": null,
        "examples": [],
        "min_length": null,
        "max_length": null,
        "min_value": null,
        "max_value": null,
        "pattern": null,
        "enum_values": null,
        "format": null,
